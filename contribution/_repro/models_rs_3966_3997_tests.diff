+    #[test]
+    fn repro_3966_null_expiration_time() {
+        let with_null = r#"{"aws_temp_credentials":null,"azure_user_delegation_sas":null,"gcp_oauth_token":null,"expiration_time":null,"url":"file:///tmp/t"}"#;
+        let missing = r#"{"url":"file:///tmp/t"}"#;
+        let ok = r#"{"expiration_time":1765000000000,"url":"file:///tmp/t"}"#;
+        for (name, body) in [("null", with_null), ("missing", missing), ("present", ok)] {
+            let res = serde_json::from_str::<TemporaryTableCredentials>(body);
+            println!("{name}: {:?}", res.as_ref().map(|c| c.url.clone()).map_err(|e| e.to_string()));
+        }
+    }
