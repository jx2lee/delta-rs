+    #[test]
+    fn repro_3997_unknown_enum_values() {
+        // Databricks has added values since these enums were written, e.g. VARIANT columns,
+        // FOREIGN / METRIC_VIEW tables. Any unknown value makes GetTableResponse fail to decode.
+        let base = r#"{"name":"t","catalog_name":"c","schema_name":"s","table_type":"%TT%","data_source_format":"DELTA","columns":[{"name":"v","position":0,"nullable":true,"type_name":"%CT%"}],"storage_location":"s3://b/t","properties":{},"created_at":1,"updated_at":1,"table_id":"id"}"#;
+        for (tt, ct) in [("MANAGED", "STRING"), ("MANAGED", "VARIANT"), ("FOREIGN", "STRING"), ("MANAGED", "GEOGRAPHY")] {
+            let body = base.replace("%TT%", tt).replace("%CT%", ct);
+            let direct = serde_json::from_str::<Table>(&body).map(|_| ()).map_err(|e| e.to_string());
+            println!("  direct Table decode: {direct:?}");
+            let res = serde_json::from_str::<GetTableResponse>(&body);
+            println!("table_type={tt} type_name={ct}: {}", match &res { Ok(GetTableResponse::Success(_)) => "Success".to_string(), Ok(GetTableResponse::Error(e)) => format!("Error variant {e:?}"), Err(e) => format!("DECODE ERR {e}") });
+        }
+    }
